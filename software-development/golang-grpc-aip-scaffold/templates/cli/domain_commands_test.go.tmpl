// cmd/<binary>-cli/cmd/<domain>/<domain>_test.go — UNIT tests, no server,
// no HTTP, no wire: newGetCmd/newCreateCmd/newUpdateCmd already take the
// pkg.<Domain>Client INTERFACE, so a hand-written fake (real deterministic
// struct, no mocking framework — matches the project's "no mocks" rule)
// stands in directly. Package is <domain>_test (external test package,
// project convention) driving through the exported ProvideCommands entry
// point and Commands.Get/Create/Update fields — never call the unexported
// newGetCmd etc. from a test.
package <domain>_test

import (
	"bytes"
	"context"
	"testing"

	"github.com/stretchr/testify/require"

	"<modulePath>/cmd/<binary>-cli/cmd/<domain>"
	"<modulePath>/internal/cliutil"
	<module>v1 "<modulePath>/pkg/<module>/v1"
)

func tableFormat() cliutil.OutputFormat { return cliutil.OutputTable }

// fakeClient implements pkg.<Domain>Client with per-method closures set
// per test — a real implementation, not a mock/spy library.
type fakeClient struct {
	createFn func(context.Context, *<module>v1.Create<Domain>Request) (*<module>v1.<Domain>, error)
	getFn    func(context.Context, *<module>v1.Get<Domain>Request) (*<module>v1.<Domain>, error)
	listFn   func(context.Context, *<module>v1.List<Domain>sRequest) (*<module>v1.List<Domain>sResponse, error)
	updateFn func(context.Context, *<module>v1.Update<Domain>Request) (*<module>v1.<Domain>, error)
}

func (f *fakeClient) Create<Domain>(ctx context.Context, req *<module>v1.Create<Domain>Request) (*<module>v1.<Domain>, error) {
	return f.createFn(ctx, req)
}
func (f *fakeClient) Get<Domain>(ctx context.Context, req *<module>v1.Get<Domain>Request) (*<module>v1.<Domain>, error) {
	return f.getFn(ctx, req)
}
func (f *fakeClient) List<Domain>s(ctx context.Context, req *<module>v1.List<Domain>sRequest) (*<module>v1.List<Domain>sResponse, error) {
	return f.listFn(ctx, req)
}
func (f *fakeClient) Update<Domain>(ctx context.Context, req *<module>v1.Update<Domain>Request) (*<module>v1.<Domain>, error) {
	return f.updateFn(ctx, req)
}

func TestGetCmd_ByName(t *testing.T) {
	t.Parallel()
	c := &fakeClient{
		getFn: func(_ context.Context, req *<module>v1.Get<Domain>Request) (*<module>v1.<Domain>, error) {
			require.Equal(t, "<domain>s/1", req.GetName())
			return &<module>v1.<Domain>{Name: "<domain>s/1", DisplayName: "Example"}, nil
		},
	}
	cmds := <domain>.ProvideCommands(c, tableFormat)
	out := &bytes.Buffer{}
	cmds.Get.SetOut(out)
	cmds.Get.SetArgs([]string{"<domain>s/1"})
	require.NoError(t, cmds.Get.Execute())
	require.Contains(t, out.String(), "Example")
}

