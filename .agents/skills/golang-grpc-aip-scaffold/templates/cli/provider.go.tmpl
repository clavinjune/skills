// cmd/<binary>ctl/cmd/provider.go + wire.go — top-level CLI injector,
// same single-injector shape as internal/wire.go. Add one field to
// Dependency + one ProviderSet entry (domain package + a provideXClient
// bind function) per new domain.
package cmd

import (
	"github.com/google/wire"

	"<modulePath>/cmd/<binary>ctl/cmd/<domain>"
	"<modulePath>/pkg"
	"<modulePath>/pkg/client"
)

type Dependency struct {
	<Domain> *<domain>.Commands
	// One more field per additional domain.
}

var ProviderSet = wire.NewSet(
	ProvideDependency,
	<domain>.ProviderSet,
	provide<Domain>Client,
	// One more domain.ProviderSet + provideXClient per additional domain.
)

// provide<Domain>Client binds the shared *client.Client to this domain's
// Client interface. wire.Bind alone can't resolve a pass-through
// injector argument's concrete type to an interface — use a small
// identity function instead.
func provide<Domain>Client(c *client.Client) pkg.<Domain>Client { return c }

func ProvideDependency(<domain>Commands *<domain>.Commands) *Dependency {
	return &Dependency{<Domain>: <domain>Commands}
}
