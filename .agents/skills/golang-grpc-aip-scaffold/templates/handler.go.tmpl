func (h *handler) list{{.Plural}}(w http.ResponseWriter, r *http.Request) {
	pageSize, _ := strconv.ParseInt(r.URL.Query().Get("page_size"), 10, 32)
	items, nextPageToken, err := h.service.List{{.Plural}}(r.Context(), int32(pageSize), r.URL.Query().Get("page_token"))
	if err != nil {
		httpjson.WriteError(w, err)
		return
	}
	_ = httpjson.Write(w, http.StatusOK, &{{.module}}v1.List{{.Plural}}Response{
		{{.Plural}}:      items,
		NextPageToken: nextPageToken,
	})
}

func (h *handler) update{{.Domain}}(w http.ResponseWriter, r *http.Request) {
	body, err := httpjson.Read[{{.module}}v1.{{.Domain}}](r)
	if err != nil {
		httpjson.WriteError(w, err)
		return
	}
	body.Name = pkg.Format{{.Domain}}Name(r.PathValue("{{.domain}}"))

	var paths []string
	if raw := r.URL.Query().Get("update_mask"); raw != "" {
		paths = strings.Split(raw, ",")
	}
	resp, err := h.service.Update{{.Domain}}(r.Context(), &body, paths)
	if err != nil {
		httpjson.WriteError(w, err)
		return
	}
	_ = httpjson.Write(w, http.StatusOK, resp)
}

func (h *handler) delete{{.Domain}}(w http.ResponseWriter, r *http.Request) {
	name := pkg.Format{{.Domain}}Name(r.PathValue("{{.domain}}"))
	if err := h.service.Delete{{.Domain}}(r.Context(), name); err != nil {
		httpjson.WriteError(w, err)
		return
	}
	w.WriteHeader(http.StatusNoContent)
}
