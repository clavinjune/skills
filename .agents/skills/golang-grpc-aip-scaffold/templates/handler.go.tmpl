}

// Register mounts the {{.domain}} routes on the mux (Go 1.22+ pattern syntax).
func (h *handler) Register(mux *http.ServeMux) {
	mux.HandleFunc("POST /{{.plural}}", h.create{{.Domain}})
	mux.HandleFunc("GET /{{.plural}}/{ {{- .domain -}} }", h.get{{.Domain}})
	mux.HandleFunc("GET /{{.plural}}", h.list{{.Plural}})
	mux.HandleFunc("PATCH /{{.plural}}/{ {{- .domain -}} }", h.update{{.Domain}})
	mux.HandleFunc("DELETE /{{.plural}}/{ {{- .domain -}} }", h.delete{{.Domain}})
}

func (h *handler) create{{.Domain}}(w http.ResponseWriter, r *http.Request) {
	body, err := httpjson.Read[{{.module}}v1.{{.Domain}}](r)
	if err != nil {
		httpjson.WriteError(w, err)
		return
	}
	resp, err := h.service.Create{{.Domain}}(r.Context(), &body)
	if err != nil {
		httpjson.WriteError(w, err)
		return
	}
	_ = httpjson.Write(w, http.StatusCreated, resp)
}

func (h *handler) get{{.Domain}}(w http.ResponseWriter, r *http.Request) {
	resp, err := h.service.Get{{.Domain}}(r.Context(), pkg.Format{{.Domain}}Name(r.PathValue("{{.domain}}")))
	if err != nil {
		httpjson.WriteError(w, err)
		return
